{
  "name": "@espresso-notify/node",
  "version": "0.1.0",
  "description": "Node.js server library for the Espresso Notify API: typed sends, retries with idempotency keys, and webhook signature verification.",
  "keywords": [
    "push-notifications",
    "push",
    "notifications",
    "webhook",
    "webhook-signature",
    "idempotency",
    "fcm",
    "apns",
    "expo",
    "espresso-notify",
    "server"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Caffeee Labs",
    "url": "https://espressonotify.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/espresso-notify/espresso-notify-node.git"
  },
  "bugs": {
    "url": "https://github.com/espresso-notify/espresso-notify-node/issues"
  },
  "homepage": "https://docs.espressonotify.com/docs/server-libraries/node",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "python3 ../tools/generate.py node",
    "generate:check": "python3 ../tools/generate.py node --check",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
