      "to": {
        "external_id": "user-1001"
      }
    },
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "response": {
    "body": {
      "code": "idempotency_key_reused",
      "error": "idempotency_key_reused"
    },
    "headers": {
      "Content-Type": "application/json; charset=utf-8"
    },
    "status": 422
  }
}
