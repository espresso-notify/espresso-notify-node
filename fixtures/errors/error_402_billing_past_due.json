{
  "description": "The organization's billing is not healthy, so a send is refused.",
  "key": "secret",
  "method": "POST",
  "operationId": "sendTransactional",
  "path": "/v1/notifications/transactional",
  "pathTemplate": "/v1/notifications/transactional",
  "request": {
    "body": {
      "body": "Order 8123 is on its way",
      "idempotency_key": "order-8123-shipped",
      "title": "Your order shipped",
      "to": {
        "external_id": "user-1001"
      }
    },
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "response": {
    "body": {
      "code": "subscription_past_due",
      "error": "Pagamento pendente: o acesso está pausado e volta automaticamente quando o pagamento for regularizado."
    },
    "headers": {
      "Content-Type": "application/json; charset=utf-8"
    },
    "status": 402
  }
}
